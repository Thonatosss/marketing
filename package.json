{
  "name": "prime-digital-group-landing",
  "version": "2.0.0",
  "private": true,
  "description": "Лендінг Prime Digital Group",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build:css": "sass --style=compressed --no-source-map sass/main.scss assets/css/styles.css",
    "build:js": "esbuild js/main.js --bundle --minify --format=iife --outfile=assets/js/main.js --loader:.png=file --loader:.svg=file --asset-names=[name]-[hash] --public-path=./",
    "build": "npm run build:css && npm run build:js",
    "watch:css": "sass --watch sass/main.scss assets/css/styles.css",
    "images": "node scripts/optimize-images.mjs",
    "serve": "npx --yes http-server . -p 5501 -c-1"
  },
  "dependencies": {
    "@splidejs/splide": "^4.1.4",
    "aos": "^2.3.4",
    "intl-tel-input": "18.1.1",
    "modern-normalize": "^1.1.0",
    "particles.js": "^2.0.0"
  },
  "devDependencies": {
    "esbuild": "^0.25.0",
    "sass": "^1.80.0",
    "sharp": "^0.35.5"
  }
}
